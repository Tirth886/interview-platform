APP_NAME=resume-parser
APP_ENV=development
HOST=0.0.0.0
PORT=5001

MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx

# Shared with hiring_service local uploads (or S3 later)
RESUME_FILES_ROOT=../hiring_service/uploads
PARSED_OUTPUT_DIR=./parsed

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RESUME_PARSE_QUEUE=resume.parse.requested
RESUME_PARSE_COMPLETED_QUEUE=resume.parse.completed

# Callback into hiring_service (optional if using completed queue only)
HIRING_SERVICE_URL=http://localhost:3000
HIRING_SERVICE_INTERNAL_TOKEN=dev-internal-token

# spaCy model
SPACY_MODEL=en_core_web_sm
