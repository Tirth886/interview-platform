NODE_ENV=development
PORT=3000

# PostgreSQL (example)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiring_platform?sslmode=disable

# JWT secrets must be at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-32+
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# Microsoft SSO
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3000/api/v1/auth/microsoft/callback

# Company portal URL (used for SSO redirects)
FRONTEND_URL=http://localhost:5173

# Interview portal URL (candidate schedule + session links)
INTERVIEW_PORTAL_URL=http://localhost:5174

# File uploads
UPLOAD_DIR=uploads
STORAGE_DRIVER=local

# Resume batch upload limits
RESUME_UPLOAD_MAX_FILES=20
RESUME_UPLOAD_MAX_FILE_SIZE_MB=10
RESUME_UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx

# RabbitMQ (resume parse jobs)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RESUME_PARSE_QUEUE=resume.parse.requested
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Resend email (https://resend.com) — when unset, schedule emails are logged to the API console
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM=Hiring <hiring@your-verified-domain.com>
